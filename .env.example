# COLBIOS Dues — environment variables
#
# Copy to .env for local development:   cp .env.example .env
# Never commit .env. Never put live credentials in this file.
#
# Every variable below except NEXT_PUBLIC_APP_URL is server-only. Nothing here
# is bundled into the browser: the modules that read them are marked
# `server-only`, so importing one from a client component fails the build.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# PostgreSQL 14+. On Vercel use a managed database (Neon, Supabase, RDS…).
DATABASE_URL="postgresql://user:password@host:5432/colbios?sslmode=require"

# Only needed when the database is behind a connection pooler (Supabase's
# pgbouncer, Neon's pooled endpoint). Migrations need the direct connection.
# SHADOW_DATABASE_URL="postgresql://user:password@host:5432/colbios_shadow"

# ---------------------------------------------------------------------------
# Paystack (required)
# ---------------------------------------------------------------------------
# Test keys start sk_test_/pk_test_ and move no real money.
# Swap for the live keys only after institutional approval — nothing else in
# the application needs to change.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Sessions (required)
# ---------------------------------------------------------------------------
# At least 32 characters. Generate one with:  openssl rand -base64 32
# Rotating this signs every administrator out; it never affects payments.
NEXTAUTH_SECRET="generate-a-long-random-value-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Public application URL (required)
# ---------------------------------------------------------------------------
# Receipt links, verification links, QR codes and the Paystack callback are all
# built from this. It must be the URL students actually reach.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------
# Without these, payments still work end to end; confirmation emails are
# skipped and the omission is logged. FROM_EMAIL must be a domain verified in
# Resend.
RESEND_API_KEY=""
FROM_EMAIL="COLBIOS Dues <dues@your-verified-domain.edu.ng>"

# ---------------------------------------------------------------------------
# Local development only — ignored when NODE_ENV=production
# ---------------------------------------------------------------------------
# Points the Paystack client at the local mock (npm run mock:paystack) so the
# whole flow can be exercised offline. A production deployment always talks to
# api.paystack.co no matter what this is set to.
# PAYSTACK_BASE_URL="http://127.0.0.1:4010"

# Test database used by `npm test`. Its name must contain "test" — the runner
# refuses to touch anything else, because it truncates every table.
# TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5432/colbios_test"

# ---------------------------------------------------------------------------
# First administrator (used once, by `npm run admin:bootstrap`)
# ---------------------------------------------------------------------------
# Optional: the script prompts for these if they are not set. Prefer the
# prompts — an exported password ends up in your shell history.
# ADMIN_EMAIL="finance@funaab.edu.ng"
# ADMIN_NAME="Finance Officer"
# ADMIN_PASSWORD=""
